# Groq free tier (default). Get a key at https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional paid fallback if LLM_API_KEY is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Internal review only. Not linked from the public site.
ADMIN_PASSWORD=

# Allow video over 2 minutes (HUMAN + AI PRO). Default is the 2-minute cap.
PRO_LONG_VIDEO=
