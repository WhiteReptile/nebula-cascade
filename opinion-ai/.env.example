# Groq free tier (default). Get a key at https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional paid fallback if LLM_API_KEY is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Internal review only. Not linked from the public site.
ADMIN_PASSWORD=

# Allow video over 2 minutes (Hybrid PRO). Default is the 2-minute cap.
PRO_LONG_VIDEO=

# 1 = public free text AI. 0 = closed except admin.
PUBLIC_OPEN=1

# 1 = accept music/video/image/PDF-queue uploads. 0 = closed.
# Default: open in npm run dev, closed in production.
HYBRID_QUEUE_OPEN=

# Shared opinions JSON. Default: open in dev, empty list in production.
PUBLIC_REVIEWS=

# Stop all guest free-AI calls for the day at this count (Groq safety net).
LLM_DAILY_MAX_CALLS=1000

# Max Hybrid file uploads per IP per hour when the queue is open.
QUEUE_PER_HOUR=5

